POSTGRES_DB=collab_pm
POSTGRES_USER=collab_pm_user
POSTGRES_PASSWORD=change-me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_REALM=collab-pm
KEYCLOAK_CLIENT_ID=collab-pm-frontend
FRONTEND_PUBLIC_URL=https://app.example.com
KEYCLOAK_PUBLIC_URL=https://auth.example.com
KEYCLOAK_HOST_PORT=8081

KEYCLOAK_ISSUER_URI=https://auth.example.com/realms/collab-pm
KEYCLOAK_JWK_SET_URI=https://auth.example.com/realms/collab-pm/protocol/openid-connect/certs

BACKEND_IMAGE=docker.io/example/collab-pm-backend:latest
FRONTEND_IMAGE=docker.io/example/collab-pm-frontend:latest
FRONTEND_HOST_PORT=80
